# Google sign-in: an OAuth client of type "Desktop app" from the Google Cloud Console,
# in a project with the People API enabled. Put these in `.env` (not committed):
# they are read at build time and compiled into the app. Without them
# "Sign in with Google" can't work.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AppStore
APP_STORE_MANIFEST_URL=
